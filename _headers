# Cloudflare Pages – Header-Regeln
# Doku: https://developers.cloudflare.com/pages/configuration/headers/
#
# Cookie-/Consent-Management (js/consent.js): Aktuell ist ein Drittanbieter
# eingebunden, der NICHT über den Consent-Banner gesteuert wird – Adobe
# Fonts/Typekit für die Überschriften-Schriftart "The Seasons" (direkt in
# index.html <head> verlinkt, use.typekit.net/p.typekit.net in
# style-src/font-src). MANUELL PRÜFEN (Rechtsberatung): Dieses ungegatete
# Laden überträgt bei jedem Seitenaufruf die Besucher-IP an Adobe (USA) –
# siehe Datenschutzerklärung Abschnitt 4. Weitere Drittanbieter (Google Tag
# Manager/Analytics/Ads, Google Maps, Calendly, WhatsApp) sind NICHT
# eingebunden, daher bleibt die CSP ansonsten bewusst eng ("script-src
# 'self'", "connect-src 'self'"). Sobald ein weiterer Dienst NACH aktiver
# Einwilligung tatsächlich geladen werden soll, MUSS die CSP gezielt um
# genau die benötigten Domains erweitert werden, z. B. (MANUELL PRÜFEN –
# nur bei tatsächlichem Bedarf ergänzen, keine pauschalen Wildcards):
#   Google Tag Manager/Analytics: script-src https://www.googletagmanager.com;
#     connect-src https://www.google-analytics.com https://analytics.google.com;
#     img-src https://www.googletagmanager.com
#   Google Ads: connect-src https://googleads.g.doubleclick.net
#   Google Maps: script-src https://maps.googleapis.com;
#     frame-src https://www.google.com/maps/; img-src https://maps.gstatic.com
#   Calendly: script-src https://assets.calendly.com;
#     frame-src https://calendly.com; connect-src https://calendly.com
#   WhatsApp-Widget (falls kein reiner wa.me-Link): frame-src/connect-src
#     entsprechend der eingesetzten Widget-Domain

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' https://use.typekit.net https://p.typekit.net; script-src 'self'; font-src 'self' https://use.typekit.net https://p.typekit.net; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests

# HTML immer frisch ausliefern (Cloudflare-CDN cached weiterhin am Edge)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Schriften ändern sich nie
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder: 30 Tage. Alle Fotos (Vollformat, -800-Varianten, webp) und die
# Logos liegen in /img/; im Root stehen nur noch Favicon und Touch-Icon.
/img/*
  Cache-Control: public, max-age=2592000

# CSS/JS: der Browser fragt jedes Mal kurz nach (ETag → 304, wenige Byte).
# Vorher standen hier 7 Tage – nach einem Deploy sahen Besucher tagelang
# neues HTML mit altem CSS, und die Seite fiel auseinander.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/main.js
  Cache-Control: public, max-age=0, must-revalidate

/js/animations.js
  Cache-Control: public, max-age=0, must-revalidate

/js/consent.js
  Cache-Control: public, max-age=0, must-revalidate

# Die GSAP-Dateien sind versioniert und ändern sich nie
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Sitemap + ihr Branding-Stylesheet: ändern sich mit dem Seiteninhalt
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xsl
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/xslt+xml; charset=UTF-8
