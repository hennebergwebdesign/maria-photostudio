# Cloudflare Pages – Header-Regeln
# Doku: https://developers.cloudflare.com/pages/configuration/headers/
#
# Cookie-/Consent-Management (js/consent.js): Aktuell sind keine
# Drittanbieter (Google Tag Manager/Analytics/Ads, Google Maps, Calendly,
# WhatsApp) eingebunden, daher bleibt die CSP unten bewusst eng
# ("script-src 'self'", "connect-src 'self'"). Sobald ein solcher Dienst
# NACH aktiver Einwilligung tatsächlich geladen werden soll, MUSS die CSP
# gezielt um genau die benötigten Domains erweitert werden, z. B.
# (MANUELL PRÜFEN – nur bei tatsächlichem Bedarf ergänzen, keine
# pauschalen Wildcards):
#   Google Tag Manager/Analytics: script-src https://www.googletagmanager.com;
#     connect-src https://www.google-analytics.com https://analytics.google.com;
#     img-src https://www.googletagmanager.com
#   Google Ads: connect-src https://googleads.g.doubleclick.net
#   Google Maps: script-src https://maps.googleapis.com;
#     frame-src https://www.google.com/maps/; img-src https://maps.gstatic.com
#   Calendly: script-src https://assets.calendly.com;
#     frame-src https://calendly.com; connect-src https://calendly.com
#   WhatsApp-Widget (falls kein reiner wa.me-Link): frame-src/connect-src
#     entsprechend der eingesetzten Widget-Domain

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests

# HTML immer frisch ausliefern (Cloudflare-CDN cached weiterhin am Edge)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Schriften ändern sich nie
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder: 30 Tage
/img/*
  Cache-Control: public, max-age=2592000

# Shooting-Fotos im Root (jpeg/jpg-Vollformat, -800-Varianten, webp):
# ebenfalls 30 Tage, gleiche Regel wie /img/*
/*.jpeg
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

# CSS/JS: der Browser fragt jedes Mal kurz nach (ETag → 304, wenige Byte).
# Vorher standen hier 7 Tage – nach einem Deploy sahen Besucher tagelang
# neues HTML mit altem CSS, und die Seite fiel auseinander.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/main.js
  Cache-Control: public, max-age=0, must-revalidate

/js/animations.js
  Cache-Control: public, max-age=0, must-revalidate

/js/consent.js
  Cache-Control: public, max-age=0, must-revalidate

# Die GSAP-Dateien sind versioniert und ändern sich nie
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable
